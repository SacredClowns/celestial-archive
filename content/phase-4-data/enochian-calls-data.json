      "number": 1,
      "title": "The First Call",
      "receptionOrder": 19,
      "totalLines": 9,
      "association": {
        "type": "general",
        "description": "A general invocation addressing the pillars of gladness and the supreme divine authority. Not associated with a specific Watchtower quadrant.",
        "deeNote": "The first and most general Call, invoking the presence and authority of the divine.",
        "badge": "historical"
      },
      "historicalNotes": [
        {
          "text": "The First Call was the last to be received (received 19th in sequence). Dee understood it as the most powerful and general of the invocations.",
          "source": "Sloane MS 3191; Casaubon (1659)",
          "badge": "historical"
        }
      ],
      "scholarlyNotes": [
        {
          "scholar": "Laycock",
          "observation": "The First Call contains the highest concentration of unique vocabulary of any single Call. Several words appear only here.",
          "badge": "consensus"
        }
      ],
      "lines": "PENDING_TRANSCRIPTION",
      "_lineNote": "Full line-by-line Enochian text and English translation to be transcribed from Peterson's edition of Sloane MS 3191. The public-domain manuscript text must be verified against at least two published sources before inclusion."
