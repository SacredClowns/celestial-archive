    {
      "number": 19,
      "title": "The Nineteenth Call (The Call of the Aethyrs)",
      "receptionOrder": 1,
      "totalLines": 22,
      "association": {
        "type": "aethyr",
        "description": "The Call of the 30 Aethyrs. Contains a variable position where the three-letter name of the target Aethyr is substituted. This single template generates 30 distinct invocations — one for each Aethyr from TEX (30th, outermost) to LIL (1st, innermost).",
        "deeNote": "This was the first Call received. The angel Nalvage described the Calls as 'the Natural Keys to open those, not 49 but 48 (for one is not to be opened) Gates of Understanding.'",
        "badge": "historical"
      },
      "historicalNotes": [
        {
          "text": "The Nineteenth Call was the first to be received in the dictation sequence. It is the longest Call and the only one that functions as a template with a variable component. It was understood as the key to accessing the 30 Aethyrs — the vertical axis of the Enochian cosmos.",
          "source": "Sloane MS 3191; Cotton Appendix XLVI",
          "badge": "historical"
        },
        {
          "text": "Crowley used this Call extensively during his 1909 Algerian workings, producing The Vision and the Voice (Liber 418) — detailed visionary accounts of each Aethyr. These visions became the most influential experiential account of the Aethyr system, though they postdate Dee by 325 years.",
          "source": "Crowley, The Vision and the Voice (1911/1998)",
          "badge": "historical"
        }
      ],
      "scholarlyNotes": [
        {
          "scholar": "Laycock",
          "observation": "The 19th Call contains the largest concentration of unique vocabulary and the most complex sentence structures in the entire Enochian corpus. Several grammatical patterns appear only here.",
          "badge": "consensus"
        },
        {
          "scholar": "Leitch",
          "observation": "The variable position for the Aethyr name is the only parametric element in the entire Call system — no other Call contains a substitutable component.",
          "badge": "consensus"
        }
      ],
      "lines": "PENDING_TRANSCRIPTION",
      "aethyrVariable": {
        "position": "line 1",
        "placeholder": "[AETHYR_NAME]",
        "note": "Replace with the three-letter name of the target Aethyr (e.g., TEX, ZAX, LIL)"
      }
    }
